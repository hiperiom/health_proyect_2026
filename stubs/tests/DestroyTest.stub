<?php

use App\Models\{{Singular}};
use App\Models\Role;
use App\Models\User;

use function Pest\Laravel\actingAs;
use function Pest\Laravel\delete;

beforeEach(function () {
    $this->role = Role::query()->firstOrCreate(
        ['slug' => 'superusuario'],
        ['name' => 'Superusuario']
    );

    $this->user = User::factory()->create();
    $this->user->roles()->sync([$this->role->id]);

    $this->item = {{Singular}}::factory()->create();
});

it('deletes a {{DisplayName}}', function () {
    $response = actingAs($this->user)
        ->delete(route('{{Kebab}}.destroy', $this->item))
        ->assertStatus(302);

    expect($response->headers->get('Location'))->toBe(route('{{Kebab}}.index'));

    $this->assertDatabaseMissing('{{Table}}', [
        'id' => $this->item->id,
    ]);
});

it('redirects guests to login on destroy', function () {
    delete(route('{{Kebab}}.destroy', $this->item))
        ->assertRedirect('/login');
});
